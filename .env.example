# Example .env file for local testing with @github/local-action
# Copy to .env and fill in values

# Required inputs
INPUT_ALLOWED-KEYS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
INPUT_GITHUB-TOKEN=ghp_your_token_here

# Optional inputs
INPUT_REQUIRE-CANARY=false
INPUT_CANARY-CHAIN=ethereum
INPUT_CANARY-RPC-URL=
INPUT_CANARY-MIN-BALANCE=10000000000000000
INPUT_SIGNATURE-MAX-AGE=3600

# GitHub context (simulated)
GITHUB_REPOSITORY=owner/repo
GITHUB_EVENT_NAME=pull_request
GITHUB_EVENT_PATH=./test-fixtures/pull_request_event.json
