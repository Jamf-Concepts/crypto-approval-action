{
  "name": "crypto-approval-action",
  "version": "0.1.0",
  "description": "GitHub Action requiring hardware wallet signatures for PR approvals with optional blockchain canary",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "format": "prettier --write \"src/**/*.ts\" \"cli/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"cli/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint": "eslint src cli __tests__ --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "local": "local-action run . src/main.ts .env",
    "all": "npm run format && npm run lint && npm run test && npm run bundle",
    "cli": "tsx cli/sign.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danjamf/crypto-approval-action.git"
  },
  "keywords": [
    "github-actions",
    "crypto",
    "hardware-wallet",
    "pr-approval",
    "security"
  ],
  "author": "Dan Cuddeford",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "ethers": "^6.11.0",
    "viem": "^2.9.0"
  },
  "devDependencies": {
    "@github/local-action": "^2.0.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rollup": "^4.12.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
