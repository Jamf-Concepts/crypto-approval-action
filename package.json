{
  "name": "crypto-approval-action",
  "version": "0.1.0",
  "description": "GitHub Action requiring hardware wallet signatures for PR approvals with optional blockchain canary",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "format": "prettier --write \"src/**/*.ts\" \"cli/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"cli/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint": "eslint src cli __tests__",
    "test": "jest",
    "test:watch": "jest --watch",
    "all": "npm run format && npm run lint && npm run test && npm run bundle",
    "cli": "tsx cli/sign.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jamf-Concepts/crypto-approval-action.git"
  },
  "overrides": {
    "undici": ">=6.28.1"
  },
  "keywords": [
    "github-actions",
    "crypto",
    "hardware-wallet",
    "pr-approval",
    "security"
  ],
  "author": "Dan Cuddeford",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "ethers": "^6.11.0",
    "viem": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jest": "^28.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
